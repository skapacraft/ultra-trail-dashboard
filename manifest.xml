<?xml version="1.0" encoding="UTF-8"?>
<!--
    MANIFEST.XML
    ============
    This file describes the application to Connect IQ:
    - what KIND of app it is (datafield = the thing you pick inside a data page
      during an activity)
    - which DEVICES it can be installed on
    - which PERMISSIONS it needs (here: writing into the .FIT file)

    A NOTE ON THE GUID:
    The iq:application id="..." value is the GUID generated locally with
    `uuidgen` on 2026-07-16: eb941ffa-e0e1-4d10-83d4-6f34a684afc6. That is the
    Application ID REGISTERED for the app on the Developer Portal, assigned at
    the first upload, and it is NOT the id that appears in the URL of the public
    store listing (76cbcc4a-623e-40da-87c7-762187c3247c), which identifies the
    listing only and lives in a different namespace. The portal rejects an
    upload with an explicit error ("the app ID in the manifest file differs from
    the one registered for this app") whenever this value does not match
    eb941ffa..., so NEVER change this id after the first release unless a
    similar error from the portal says otherwise.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">

    <!--
        type="datafield"  -> tells the system this is not a standalone app but a
        data field to attach to an activity, Trail Run for instance.

        entry="UltraTrailDashboardApp" -> the name of the main Application
        class, the one defined in source/UltraTrailDashboardApp.mc

        minSdkVersion -> the minimum Connect IQ SDK version required. 3.1.0
        rather than 3.2.0, in order to include the Forerunner 935, which tops
        out at API level 3.1 but is still very common among trail and ultra
        runners.
    -->
    <iq:application
        id="eb941ffa-e0e1-4d10-83d4-6f34a684afc6"
        type="datafield"
        name="@Strings.AppName"
        entry="UltraTrailDashboardApp"
        launcherIcon="@Drawables.LauncherIcon"
        version="1.2.0"
        minSdkVersion="3.1.0">

        <!--
            The supported devices: every Garmin watch with a barometric
            altimeter and enough memory for a complex data field that writes to
            the FIT file, among those relevant to trail and ultra running. When
            a new model comes out, adding a line <iq:product id="..."/> with the
            right id is enough. The full list is in the Connect IQ SDK Manager,
            under "Devices", or through "Monkey C: Edit Products" in VS Code.
        -->
        <iq:products>
            <!-- Fenix 6, still widespread. The base variants have only 32KB
                 for data fields against the 128KB of the Pro models, but the
                 app fits regardless: checked with a trial build. -->
            <iq:product id="fenix6"/>
            <iq:product id="fenix6s"/>
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix6spro"/>
            <iq:product id="fenix6xpro"/>

            <!-- Fenix 7 -->
            <iq:product id="fenix7"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix7spro"/>
            <iq:product id="fenix7xpro"/>
            <iq:product id="fenix7pronowifi"/>
            <iq:product id="fenix7xpronowifi"/>

            <!-- Fenix 8, the current generation -->
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>

            <!-- Epix 2: the same hardware as the Fenix 7, AMOLED screen -->
            <iq:product id="epix2"/>
            <iq:product id="epix2pro42mm"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>

            <!-- Enduro: extended battery life, built for ultra-endurance,
                 which is the most natural audience for this app -->
            <iq:product id="enduro"/>
            <iq:product id="enduro3"/>

            <!-- MARQ Adventurer, Expedition and Athlete: the outdoor and
                 sport lines -->
            <iq:product id="marqadventurer"/>
            <iq:product id="marqexpedition"/>
            <iq:product id="marqathlete"/>

            <!-- The multisport and trail-oriented Forerunners: barometric
                 altimeter, and the tier Garmin positions for triathlon and
                 ultra-trail. The 255 and 265 are deliberately left out, being
                 aimed more at road and track. They do have the barometer, but
                 their trail audience is a smaller slice, so the main category
                 is where the effort goes. The FR935 is included because it is
                 historically very common among trail and ultra runners despite
                 its age; it is the reason minSdkVersion is 3.1.0. -->
            <iq:product id="fr935"/>
            <iq:product id="fr945"/>
            <iq:product id="fr945lte"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="fr970"/>

            <!--
                Forerunner 170: it has NO barometric altimeter, only GPS
                altitude, so the grade is less precise and less stable than on
                the other models. Included anyway at the explicit request of a
                user who owns one. The app stays usable: the code already
                handles a less reliable altitude safely, so the cost is
                precision rather than stability.
            -->
            <iq:product id="fr170"/>
            <iq:product id="fr170m"/>
        </iq:products>

        <!--
            THE ONE PERMISSION THAT MATTERS:
            "FitContributor" is what allows the computed fields to be written
            into the activity's .FIT file, so they can be seen and graphed
            afterwards on Garmin Connect and Strava. Without it, the
            createField() calls in the code would fail.
        -->
        <iq:permissions>
            <iq:uses-permission id="FitContributor"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>ita</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>

    </iq:application>

</iq:manifest>
