<?xml version="1.0" encoding="UTF-8"?>
<!--
    DRAWABLES.XML
    =============
    Registers the app's launcher icon. A data field has no visible icon the way
    a standalone app does, but the Connect IQ compiler requires one anyway to
    validate the manifest.

    launcher_icon.svg is a minimal vector icon, a stylised mountain on a blue
    background, produced as a placeholder. It can be replaced at any point with
    a different drawing, same filename and same folder, without touching this
    XML or the manifest. Using an SVG rather than a fixed-size PNG avoids the
    rescaling warnings: the compiler generates the right size for each target
    device automatically (40x40 on Fenix 7, 65x65 on FR965, and so on).
-->
<resources>
    <bitmap id="LauncherIcon" filename="launcher_icon.svg"/>
 
</resources>
