<?xml version="1.0" encoding="UTF-8"?>
<!--
    PROPERTIES.XML
    ==============
    Declares the app's persistent settings: values the user can change from
    Garmin Connect Mobile, or from the simulator, WITHOUT recompiling. The
    system stores them on the watch and restores them at every start.

    CAREFUL: the numeric values of the quadrants are a contract with the SRC_*
    constants in source/UltraTrailDashboardView.mc and with the <listEntry>
    elements in settings.xml. They have to stay aligned, and above all they must
    NEVER be reordered after a release: the configuration already saved on
    people's watches would then point at the wrong field.
-->
<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <!--
        Length in seconds of the moving-average window used to steady the grade.
        10 seconds by default, explained in UltraTrailDashboardView.mc. Anyone
        running very technical trails may prefer a shorter window, for a more
        responsive grade, or a longer one, for a steadier one.
    -->
    <property id="SmoothingWindowSeconds" type="number">10</property>

    <!--
        The source of each of the 4 quadrants.
          0 = pace    1 = heart rate    2 = grade    3 = GAP
          4 = anaerobic reserve    5 = time to limit
          6 = sustainable pace    7 = carbohydrate left
          8 = descending capacity
        The defaults reproduce the layout of earlier versions exactly, so
        somebody upgrading finds nothing different until they choose to change
        it themselves.
    -->
    <property id="Quadrant1" type="number">0</property>
    <property id="Quadrant2" type="number">1</property>
    <property id="Quadrant3" type="number">2</property>
    <property id="Quadrant4" type="number">3</property>

    <!--
        Threshold pace, in seconds per the device's distance unit (seconds/km on
        metric, seconds/mile on imperial). It is ONLY a starting point, used
        until the self-calibration has gathered enough data; from that moment on
        it is ignored in favour of the estimate from real running.
        0 = not set.
    -->
    <property id="ThresholdPaceSeconds" type="number">0</property>

    <!--
        Durability: the percentage of sustainable speed the athlete loses per
        100 kJ/kg of accumulated work, which is about two and a half hours of
        running at a moderate pace. It is the parameter that keeps the model
        usable past three hours, where every constant-threshold model gets it
        wrong. 0 turns the decay off.
    -->
    <property id="DurabilityPercent" type="number">8</property>

    <!--
        A switch that clears the calibration's personal bests. It re-arms
        itself: the app puts it back to false as soon as the reset is done.
    -->
    <property id="ResetCalibration" type="boolean">false</property>

    <!--
        Body mass in kg. Needed by the carbohydrate balance, which works in
        absolute grams while the rest of the engine works per kg. It is a
        setting rather than a read of the Garmin user profile because that would
        require the "UserProfile" permission, which the app does not ask for.
        See the comment in configureModels().
    -->
    <property id="BodyMassKg" type="number">70</property>

    <!--
        Carbohydrate the athlete plans to take per hour, in grams. The model
        assumes the plan is actually followed: data fields receive no button
        events, so there is no way to know when somebody really eats.
    -->
    <property id="CarbIntakeGramsPerHour" type="number">60</property>

    <!--
        How much descent the athlete takes before it becomes the problem, in
        metres. It is the parameter of the eccentric damage model, the one
        system that in long trail racing gives out before the aerobic one, and
        that no other data field models.
    -->
    <property id="DescentCapacityMeters" type="number">3000</property>

</properties>
